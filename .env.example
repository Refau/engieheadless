# One deployment: public browsing reads Publish; editor sessions read Author.
AEM_MODE=publish
AEM_ORIGIN=https://publish-p144258-e1701952.adobeaemcloud.com
AEM_AUTHOR_ORIGIN=https://author-p144258-e1701952.adobeaemcloud.com
# Origins have no path or credentials and must never come from an incoming request.
# Draft editing (optional, server-only secrets: never commit real values, never NEXT_PUBLIC_*).
# Same value as the Cloud Manager Author secret ENGIE_PREVIEW_SECRET; generate with: openssl rand -hex 32
AEM_PREVIEW_SECRET=
# Full JSON of aem-s2s-credentials.json (AEM Developer Console, OAuth Server-to-Server, read-only ENGIE permissions).
AEM_S2S_CREDENTIALS=
